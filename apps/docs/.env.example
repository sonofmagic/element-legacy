# Base public path for the docs site. Must start with "/" and may end with "/".
VITE_DOCS_BASE=/

# Default language fallback when no user preference is stored.
VITE_DOCS_DEFAULT_LANG=en-US

# Optional logo overrides. Set to an absolute URL or a path under the docs public directory (e.g. /images/custom-logo.svg).
VITE_DOCS_LOGO_PATH=
VITE_DOCS_LOGO_SMALL_PATH=

# Example environment-specific overrides.
# Copy one of the following blocks into `.env.development`, `.env.test`, or `.env.production`
# to override the shared defaults above.
#
# .env.development
# VITE_DOCS_BASE=/
# VITE_DOCS_DEFAULT_LANG=zh-CN
#
# .env.test
# VITE_DOCS_BASE=/preview/
# VITE_DOCS_DEFAULT_LANG=en-US
#
# .env.production
# VITE_DOCS_BASE=/element/
# VITE_DOCS_DEFAULT_LANG=en-US
