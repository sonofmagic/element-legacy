# Base public path for the docs site. Must start with "/" and may end with "/".
VITE_DOCS_BASE=/

# Default language fallback when no user preference is stored.
VITE_DOCS_DEFAULT_LANG=en-US

# Optional logo overrides. Set to an absolute URL if you want to replace the defaults.
VITE_DOCS_LOGO_PATH=
VITE_DOCS_LOGO_SMALL_PATH=
