.el-tag {
  color: #409eff;
  background-color: rgb(235.9, 245.3, 255);
  border-color: rgb(216.8, 235.6, 255);
}
.el-tag.is-hit {
  border-color: #409eff;
}

.el-tag .el-tag__close {
  color: #409eff;
}
.el-tag .el-tag__close:hover {
  color: #fff;
  background-color: #409eff;
}
.el-tag.el-tag--info {
  color: #909399;
  background-color: rgb(243.9, 244.2, 244.8);
  border-color: rgb(232.8, 233.4, 234.6);
}
.el-tag.el-tag--info.is-hit {
  border-color: #909399;
}

.el-tag.el-tag--info .el-tag__close {
  color: #909399;
}
.el-tag.el-tag--info .el-tag__close:hover {
  color: #fff;
  background-color: #909399;
}
.el-tag.el-tag--success {
  color: #67c23a;
  background-color: rgb(239.8, 248.9, 235.3);
  border-color: rgb(224.6, 242.8, 215.6);
}
.el-tag.el-tag--success.is-hit {
  border-color: #67c23a;
}

.el-tag.el-tag--success .el-tag__close {
  color: #67c23a;
}
.el-tag.el-tag--success .el-tag__close:hover {
  color: #fff;
  background-color: #67c23a;
}
.el-tag.el-tag--warning {
  color: #e6a23c;
  background-color: rgb(252.5, 245.7, 235.5);
  border-color: rgb(250, 236.4, 216);
}
.el-tag.el-tag--warning.is-hit {
  border-color: #e6a23c;
}

.el-tag.el-tag--warning .el-tag__close {
  color: #e6a23c;
}
.el-tag.el-tag--warning .el-tag__close:hover {
  color: #fff;
  background-color: #e6a23c;
}
.el-tag.el-tag--danger {
  color: #f56c6c;
  background-color: rgb(254, 240.3, 240.3);
  border-color: rgb(253, 225.6, 225.6);
}
.el-tag.el-tag--danger.is-hit {
  border-color: #f56c6c;
}

.el-tag.el-tag--danger .el-tag__close {
  color: #f56c6c;
}
.el-tag.el-tag--danger .el-tag__close:hover {
  color: #fff;
  background-color: #f56c6c;
}
.el-tag {
  -webkit-box-sizing: border-box;
  box-sizing: border-box;
  display: inline-block;
  height: 32px;
  padding: 0 10px;
  font-size: 12px;
  line-height: 30px;
  color: #409eff;
  white-space: nowrap;
  border-style: solid;
  border-width: 1px;
  border-radius: 4px;
}
.el-tag .el-icon-close {
  position: relative;
  top: -1px;
  right: -5px;
  width: 16px;
  height: 16px;
  font-size: 12px;
  line-height: 16px;
  vertical-align: middle;
  text-align: center;
  cursor: pointer;
  border-radius: 50%;
}
.el-tag .el-icon-close::before {
  display: block;
}
.el-tag--dark {
  color: white;
  background-color: #409eff;
  border-color: #409eff;
}
.el-tag--dark.is-hit {
  border-color: #409eff;
}

.el-tag--dark .el-tag__close {
  color: white;
}
.el-tag--dark .el-tag__close:hover {
  color: #fff;
  background-color: rgb(102.2, 177.4, 255);
}
.el-tag--dark.el-tag--info {
  color: white;
  background-color: #909399;
  border-color: #909399;
}
.el-tag--dark.el-tag--info.is-hit {
