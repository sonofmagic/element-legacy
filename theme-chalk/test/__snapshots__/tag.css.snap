  background-color: white;
  border-color: rgb(210.6, 211.8, 214.2);
}
.el-tag--plain.el-tag--info.is-hit {
  border-color: #909399;
}

.el-tag--plain.el-tag--info .el-tag__close {
  color: #909399;
}
.el-tag--plain.el-tag--info .el-tag__close:hover {
  color: #fff;
  background-color: #909399;
