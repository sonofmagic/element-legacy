.el-input-group {
  display: inline-table;
  width: 100%;
  line-height: normal;
  border-spacing: 0;
  border-collapse: separate;
}
.el-input-group > .el-input__inner {
  display: table-cell;
  vertical-align: middle;
}
.el-input-group__append,
.el-input-group__prepend {
  position: relative;
  display: table-cell;
  width: 1px;
  padding: 0 20px;
  vertical-align: middle;
  color: #909399;
  white-space: nowrap;
  background-color: #f5f7fa;
