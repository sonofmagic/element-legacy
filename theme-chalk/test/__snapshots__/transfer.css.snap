.el-transfer-panel {
  position: relative;
  -webkit-box-sizing: border-box;
  box-sizing: border-box;
  display: inline-block;
  width: 200px;
  max-height: 100%;
  overflow: hidden;
  vertical-align: middle;
  background: #fff;
  border: 1px solid #ebeef5;
  border-radius: 4px;
}
.el-transfer-panel__body {
