}
.el-transfer-panel .el-transfer-panel__empty {
  height: 30px;
  padding: 6px 15px 0;
  margin: 0;
  line-height: 30px;
  color: #909399;
  text-align: center;
}
.el-transfer-panel .el-checkbox__label {
  padding-left: 8px;
}
.el-transfer-panel .el-checkbox__inner {
  width: 14px;
  height: 14px;
  border-radius: 3px;
}
.el-transfer-panel .el-checkbox__inner::after {
  left: 4px;
  width: 3px;
  height: 6px;
}
