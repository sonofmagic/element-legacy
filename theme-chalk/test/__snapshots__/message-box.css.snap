.v-modal-enter {
  -webkit-animation: v-modal-in 0.2s ease;
  animation: v-modal-in 0.2s ease;
}

.v-modal-leave {
  -webkit-animation: v-modal-out 0.2s ease forwards;
  animation: v-modal-out 0.2s ease forwards;
}

@-webkit-keyframes v-modal-in {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

@keyframes v-modal-in {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}
@-webkit-keyframes v-modal-out {
  0% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}
@keyframes v-modal-out {
  0% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}
.v-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #000;
  opacity: 0.5;
}

.el-popup-parent--hidden {
  overflow: hidden;
}

.el-button {
  -webkit-box-sizing: border-box;
  box-sizing: border-box;
  display: inline-block;
  margin: 0;
  font-weight: 500;
  line-height: 1;
  color: #606266;
  text-align: center;
  white-space: nowrap;
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  cursor: pointer;
  outline: none;
  background: #fff;
  border: 1px solid #dcdfe6;
  border-color: #dcdfe6;
  -webkit-transition: 0.1s;
  transition: 0.1s;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
}
.el-button + .el-button {
  margin-left: 10px;
}
.el-button {
  padding: 12px 20px;
  font-size: 14px;
  border-radius: 4px;
}
.el-button.is-round {
  padding: 12px 20px;
}
.el-button:hover,
.el-button:focus {
  color: #409eff;
  background-color: rgb(235.9, 245.3, 255);
  border-color: rgb(197.7, 225.9, 255);
}
.el-button:active {
  color: rgb(57.6, 142.2, 229.5);
  outline: none;
  border-color: rgb(57.6, 142.2, 229.5);
}
.el-button::-moz-focus-inner {
  border: 0;
}
.el-button [class*="el-icon-"] + span {
  margin-left: 5px;
}
.el-button.is-plain:hover,
.el-button.is-plain:focus {
  color: #409eff;
  background: #fff;
  border-color: #409eff;
}
.el-button.is-plain:active {
  color: rgb(57.6, 142.2, 229.5);
  outline: none;
  background: #fff;
  border-color: rgb(57.6, 142.2, 229.5);
}

.el-button.is-active {
  color: rgb(57.6, 142.2, 229.5);
  border-color: rgb(57.6, 142.2, 229.5);
}

.el-button.is-disabled,
.el-button.is-disabled:hover,
.el-button.is-disabled:focus {
  color: #c0c4cc;
  cursor: not-allowed;
  background-color: #fff;
  background-image: none;
  border-color: #ebeef5;
}
.el-button.is-disabled.el-button--text {
  background-color: transparent;
}
.el-button.is-disabled.is-plain,
.el-button.is-disabled.is-plain:hover,
.el-button.is-disabled.is-plain:focus {
  color: #c0c4cc;
  background-color: #fff;
  border-color: #ebeef5;
}

.el-button.is-loading {
  position: relative;
  pointer-events: none;
}
.el-button.is-loading::before {
  position: absolute;
  inset: -1px;
  pointer-events: none;
  content: "";
  background-color: rgba(255, 255, 255, 0.35);
  border-radius: inherit;
}

.el-button.is-round {
  padding: 12px 23px;
  border-radius: 20px;
}

.el-button.is-circle {
  padding: 12px;
  border-radius: 50%;
}

