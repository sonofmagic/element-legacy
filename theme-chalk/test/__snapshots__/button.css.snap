.el-button--medium {
  padding: 10px 20px;
  font-size: 14px;
  border-radius: 4px;
}
.el-button--medium.is-round {
  padding: 10px 20px;
}
.el-button--medium.is-circle {
  padding: 10px;
}

.el-button--small {
  padding: 9px 15px;
  font-size: 12px;
  border-radius: 3px;
}
.el-button--small.is-round {
  padding: 9px 15px;
}
.el-button--small.is-circle {
  padding: 9px;
}

