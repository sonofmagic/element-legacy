{
  "name": "element-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "bootstrap": "pnpm install",
    "dev": "pnpm --filter element-legacy run dev",
    "dev:play": "pnpm --filter element-legacy run dev:play",
    "build": "pnpm --filter element-legacy run build",
    "build:file": "pnpm --filter element-legacy run build:file",
    "build:theme": "pnpm --filter element-legacy run build:theme",
    "build:utils": "pnpm --filter element-legacy run build:utils",
    "build:umd": "pnpm --filter element-legacy run build:umd",
    "clean": "pnpm --filter element-legacy run clean",
    "dist": "pnpm --filter element-legacy run dist",
    "i18n": "pnpm --filter element-legacy run i18n",
    "lint": "pnpm --filter element-legacy run lint",
    "test": "pnpm --filter element-legacy run test",
    "test:dev": "pnpm --filter element-legacy run test:dev",
    "pub": "pnpm --filter element-legacy run pub",
    "release": "pnpm --filter element-legacy run release",
    "deploy:build": "pnpm --filter element-legacy run deploy:build",
    "deploy:extension": "pnpm --filter element-legacy run deploy:extension",
    "dev:extension": "pnpm --filter element-legacy run dev:extension",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@icebreakers/commitlint-config": "^1.2.1",
    "@icebreakers/eslint-config": "^1.5.2",
    "@icebreakers/stylelint-config": "^1.2.1",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vitejs/plugin-vue2-jsx": "^1.1.1",
    "@vitest/coverage-v8": "~3.2.4",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.37.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "stylelint": "^16.25.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "~3.2.4"
  }
}
