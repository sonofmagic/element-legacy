    "pathe": "^2.0.3",
    "pkg-types": "^2.3.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.5",
    "sass": "1.97.0",
    "sinon": "^21.0.0",
    "stylelint": "^16.26.1",
    "tsdown": "0.18.1",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.6.3",
    "type-fest": "^5.3.1",
